# Spec Builder LLM keys (optional). With neither set, a deterministic offline mock is used.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Skip login/signup for local demo
AUTH_DISABLED=true

# Custom health check message
PING_MESSAGE=pong
